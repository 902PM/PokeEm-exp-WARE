Route9_Frlg_MapScripts::
	.byte 0

Route9_EventScript_RouteSign::
	msgbox Route9_Text_RouteSign, MSGBOX_SIGN
	end

Route9_Text_AliciaIntro::
	.string "あら ポケモン もってるわね\n… カモ だわ!$"

Route9_Text_AliciaDefeat::
	.string "あら? つよいわね$"

Route9_Text_AliciaPostBattle::
	.string "この さきの トンネル\nなかは まっくら だから\lフラッシュが ないと すすめないわ$"

Route9_Text_ChrisIntro::
	.string "だれだ?\nよさげな ポケモン もって\lふらふら あるいとる おまえは?$"

Route9_Text_ChrisDefeat::
	.string "まけよった$"

Route9_Text_ChrisPostBattle::
	.string "くやしくて なみだも でん$"

Route9_Text_DrewIntro::
	.string "イワヤマ トンネル ぬけて\nシオン タウンに\lいく ところ なんだ けど…$"

Route9_Text_DrewDefeat::
	.string "どうも だめだな$"

Route9_Text_DrewPostBattle::
	.string "なんだい きみも\nイワヤマ トンネル いくのか$"

Route9_Text_CaitlinIntro::
	.string "てかげんは なしね!$"

Route9_Text_CaitlinDefeat::
	.string "だめ! かなわないわ$"

Route9_Text_CaitlinPostBattle::
	.string "あなた きっと\nポケモンの さいのう あるのよ\lがんばってね!$"

Route9_Text_JeremyIntro::
	.string "がはは!\nちょうど いい!\lたいくつ してた とこだ$"

Route9_Text_JeremyDefeat::
	.string "まだまだ!\n… と おもったら\lもう ポケモンが ない$"

Route9_Text_JeremyPostBattle::
	.string "やまおとこに\nびびらずに たたかうとは\lたいした もんだ!$"

Route9_Text_BriceIntro::
	.string "はーっはっはッ!\nげんきな こども だ!\lいっちょう やったるか!$"

Route9_Text_BriceDefeat::
	.string "おっとっと!$"

Route9_Text_BricePostBattle::
	.string "はーっはっはッ!\nげんきで けっこう!$"

Route9_Text_BrentIntro::
	.string "まいあさ はやおき して\nそだてた さなぎが!\lやっと かえったんだ!$"

Route9_Text_BrentDefeat::
	.string "えーッ!\pぼくの はやおきは\nいったい なんだったんだあ$"

Route9_Text_BrentPostBattle::
	.string "つよく なるには むし ポケモンの\nほかも さがさないと ダメ だな$"

Route9_Text_AlanIntro::
	.string "はっはっはーッ!\nかかって こーい!$"

Route9_Text_AlanDefeat::
	.string "はーっはっはッ!\nありゃ まけた ようだな$"

Route9_Text_AlanPostBattle::
	.string "はっはっはーッ!\nやまおとこは こころが ひろいから\lまけても わらってるのだ!$"

Route9_Text_ConnerIntro::
	.string "おいらの かわいい むし ポケ!\nそれいけー!$"

Route9_Text_ConnerDefeat::
	.string "おいらの むし…$"

Route9_Text_ConnerPostBattle::
	.string "むし ポケモンの よさが\nわからない やつは むし!$"

Route9_Text_RouteSign::
	.string "ここは 9ばん どうろ\nハナダ … イワヤマ トンネル$"

