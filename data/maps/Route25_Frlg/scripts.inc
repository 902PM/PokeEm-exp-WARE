	end

Route25_Text_JoeyIntro::
	.string "この はやしは きんじょの\nトレーナーが\lれんしゅうに くる ばしょさ!$"

Route25_Text_JoeyDefeat::
	.string "なかなか できるね$"

Route25_Text_JoeyPostBattle::
	.string "ポケモンは 1ぴきだけ つよくても\nにがてな タイプには かてない\lたくさん そだてる ほうが いいよ$"

Route25_Text_DanIntro::
	.string "クチバ みなとの\nサントアンヌ ごうの パーティ\lパパと いったぜ いいだろー!$"

Route25_Text_DanDefeat::
	.string "くやしく ないもん$"

Route25_Text_DanPostBattle::
	.string "サントアンヌ ごう は\nせかいの トレーナーが\lいっぱい いたよ$"

Route25_Text_FlintIntro::
	.string "ぼくは キャンプボーイ\nかのじょは ピクニックガール!$"

Route25_Text_FlintDefeat::
	.string "トホホ…$"

Route25_Text_FlintPostBattle::
	.string "ま… いっか\nかのじょに なぐさめて もらおう$"

Route25_Text_KelseyIntro::
	.string "わたしは ピクニックガール\nかれは キャンプボーイ!$"

Route25_Text_KelseyDefeat::
	.string "ちょうし わるーい$"

Route25_Text_KelseyPostBattle::
	.string "わたしの かれも\nきみ くらい つよいと いいのに$"

Route25_Text_ChadIntro::
	.string "む…!\nきみと ぼくは たたかう よかん$"

Route25_Text_ChadDefeat::
	.string "まけそうな\nよかんが したよ$"

Route25_Text_ChadPostBattle::
	.string "こんらん して しまったら\nさっさと ポケモンを とりかえる\lさくせんも いいね$"

Route25_Text_HaleyIntro::
	.string "ともだちが かわいい ポケモン\nいっぱい もってるの\l… くやしいわ!$"

Route25_Text_HaleyDefeat::
	.string "くやしく ないもん$"

Route25_Text_HaleyPostBattle::
	.string "オツキミやま から きたの?\nじゃ あたし ピッピ ほしーい!\lねえ ちょうだい$"

Route25_Text_FranklinIntro::
	.string "オツキミ やま から\nおりてきた ばかりだが\lまだまだ げんき!$"

Route25_Text_FranklinDefeat::
	.string "がんばるなあ$"

Route25_Text_FranklinPostBattle::
	.string "くそッ\nどうくつの なかで\lズバットに かまれちまった$"

Route25_Text_NobIntro::
	.string "みさきに すんでる\nポケモン マニアの コレクション\lみに いこうと おもってな!$"

Route25_Text_NobDefeat::
	.string "やられたなあ$"

Route25_Text_NobPostBattle::
	.string "マニアという だけに\nいろいろ めずらしい ポケモンを\lもってる らしい$"

Route25_Text_WayneIntro::
	.string "マサキの いえに いくのか?\nそのまえに しょうぶ しよう!$"

Route25_Text_WayneDefeat::
	.string "やるなあ$"

Route25_Text_WaynePostBattle::
	.string "ハナダ シティに かえる ときは\nしたの ほどうを あるくと はやい$"

Route25_Text_SeaCottageSign::
	.string "ここは みさきの こや\n… マサキの いえ$"

Route25_Text_MistyHighHopesAboutThisPlace::
	.string "この みさきは ゆうめいな\nデートスポットなの…\pジムリーダーの カスミも\nあこがれてる ところなのよ$"

Route25_Text_AreYouHereAlone::
	.string "やあ きみは ひとりかい?\pせっかく ハナダのみさきに\nくる なら… ふたりじゃ なくちゃ$"

