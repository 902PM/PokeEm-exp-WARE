@ Same as Hoenn's day-care text, used by the Four Island Day-Care. Unused text translated in Emerald

DayCare_Text_ImDaycareManSpeakToMyWife::
	.string "わしは そだてや じいさんじゃ\pみんなの だいじな ポケモンの\nめんどうを みて おるのじゃよ\pなにか そだてて ほしければ\nばあさんに たのんで おくれ$"

DayCare_Text_DoYouWantEgg::
	.string "おお! あんたか\pあずかっていた ポケモンを\nそだてていたら……なんと!\pポケモンが タマゴを\nもって おったんじゃ!\pどこから もってきたか わからんが\nあんたの ポケモンが\lもってたんじゃ\pやっぱり ほしいじゃろ?$"

DayCare_Text_YourMonIsDoingFine::
	.string "おお あんたか! よくきたな\n{STR_VAR_1}は げんきじゃぞ$"

DayCare_Text_IllKeepIt::
	.string "それじゃ わしが もらおう\nありがとよ$"

DayCare_Text_YouHaveNoRoomForIt::
	.string "てもちが いっぱいの ようじゃな…\nてもちを せいり してから\lまた きなさい$"

DayCare_Text_ReceivedEgg::
	.string "{PLAYER}は そだてや じいさんから\nタマゴを もらった!$"

DayCare_Text_TakeGoodCareOfIt::
	.string "だいじに そだてなさいよ!$"

DayCare_Text_SeeWifeIfYouWantToPickUpMon::
	.string "ポケモンを ひきとりたい ときは\nばさんに いって おくれ$"

DayCare_Text_YourMonsAreDoingFine::
	.string "おお あんたか! よくきたな\n{STR_VAR_1}も {STR_VAR_2}も\lとっても げんきじゃぞ$"

DayCare_Text_IWillKeepDoYouWantIt::
	.string "わしが もらって しまうぞ\nほんとうは ほしいんじゃろ?$"

DayCare_Text_WouldYouLikeUsToRaiseMon::
	.string "わしは そだてや ばあさんじゃ\pおまえさんの かわりに ポケモンを\nそだてて あげるよ\pなにか そだてて ほしいのかい?$"

DayCare_Text_WhichMonShouldWeRaise::
	.string "どのこを そだてて みるかね?$"

DayCare_Text_WellRaiseYourMon::
	.string "それでは {STR_VAR_1}を\nしばらく あずかるぞ\pてきとうに じかんが\nたったら またきなさい$"

DayCare_Text_WeCanRaiseOneMore::
	.string "2ひき までなら あずかれるけど\nもう 1ぴき そだてて みるかい?$"

DayCare_Text_HusbandWasLookingForYou::
	.string "じいさんが あんたを\nさがして おったぞ$"

DayCare_Text_FineThenComeAgain::
	.string "そうかい\nそれじゃ また きておくれ$"

DayCare_Text_NotEnoughMoney::
	.string "おかねが たりない ようじゃのう…$"

DayCare_Text_TakeOtherOneBackToo::
	.string "もう 1ぴきも ひきとるかい?$"

DayCare_Text_ComeAgain::
	.string "それじゃ また きておくれ$"

DayCare_Text_GoodToSeeYou::
	.string "おお あんたか! よくきたな\nおまえさんの ポケモンは\lげんき じゃぞ$"

DayCare_Text_YourMonHasGrownXLevels::
	.string "{STR_VAR_1}は レベルで いうと\n{STR_VAR_2}くらい そだって おるぞ$"

DayCare_Text_YourPartyIsFull::
	.string "てもちの ポケモンが いっぱいじゃ!\nてもちを せいり したら\lまた きなさい$"

DayCare_Text_TakeBackWhichMon::
	.string "どっちの ポケモンを ひきとるかい?$"

DayCare_Text_ItWillCostX::
	.string "{STR_VAR_1}を ひきとるなら\nりょうきんは {STR_VAR_2}円 だよ$"

DayCare_Text_HeresYourMon::
	.string "はいよ たしかに!\nじゃあ つれて おかえり!$"

DayCare_Text_TookBackMon::
	.string "{PLAYER}は そだてや ばあさんから\n{STR_VAR_1}を ひきとった!$"

DayCare_Text_YouHaveJustOneMon::
	.string "おや? ポケモンが\n1ぴき しか いないようだな\pまた きなさいよ$"

DayCare_Text_TakeYourMonBack::
	.string "ポケモンを ひきとるかい?$"

DayCare_Text_WhatWillYouBattleWith::
	.string "その ポケモンを あずけると\nたたかえなく なるぞ\pまた きなさいよ$"

DayCare_Text_Huh::
	.string "おや…?$"

