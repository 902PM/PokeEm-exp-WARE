@ Flavor text for interacting with various background objects

Text_Bookshelf::
	.string "ポケモンの ほんが いっぱい!$"

Text_NothingButPokemonBooks::
	.string "ほんだなに ならんでいるのは\nポケモンの ほん ばかりだ$"

Text_ATownMap::
	.string "タウンマップだ!$"

Text_PokeMartShelf::
	.string "わあ! ポケモングッズが\nたくさん そろってる!$"

Text_DishesPlatesNeatlyLinedUp::
	.string "いろんな しょっきが\nきれいに ならんでいる!$"

Text_Kitchen::
	.string "いい においがする! なにか\zりょうりを つくったあと みたい!$"

Text_Dresser::
	.string "きれいな タンスだ!\nいろんな ものが はいりそう!$"

Text_Snacks::
	.string "いろいろな たべもの が\nおそなえ してある$"

Text_PokemartSign::
	.string "ポケモン グッズが いっぱい!\nフレンドリィショップ$"

Text_PokecenterSign::
	.string "ポケモンの たいりょく かいふく!\nポケモンセンター$"

Text_Indigo_UltimateGoal::
	.string "ここは セキエイ こうげん\pポケモン トレーナーの ちょうてん!\nポケモン リーグ ほんぶ$"

Text_Indigo_HighestAuthority::
	.string "ここは セキエイ こうげん\pポケモン さいこう きかん\nポケモン リーグ ほんぶ$"

Text_Food::
	.string "おいしそうな たべものが\nいっぱい はいってそう!$"

Text_Blueprints::
	.string "なにかの せっけいず だ!\nいろんな もじや えが かいてある$"

Text_Painting::
	.string "きれいな ポケモンの えだ!\nなんだか きもち よさそう!$"

Text_PowerPlantMachine::
	.string "なんの きかい だろう!?\nさわるのは やめて おこう!$"

Text_Telephone::
	.string "でんわだ!\nかけるのは やめておこう!$"

Text_Computer::
	.string "むずかしそうな もじや すうじ\nばかりで ちんぷんかんぷん!?$"

Text_AdvertisingPoster::
	.string "いろんな しょうひん の\nせんでんが かかれている!$"

Text_TastyFood::
	.string "いいにおい!\nおなかが なりそう!$"

Text_TrashBin::
	.string "なかには\n……\pなにも はいってない!$"

Text_Cup::
	.string "ポケモンの マークが\nはいった コップだ!$"

Text_PolishedWindow::
	.string "とても きれいに\nみがかれた まど だ!$"

Text_BeautifulSkyWindow::
	.string "まどの\nむこうには ……\pとてもきれいな そらが みえる!$"

Text_BlinkingLights::
	.string "いろんな いろの ランプが\nチカチカ ひかっている!$"

Text_NeatlyLinedUpTools::
	.string "いろんな どうぐが\nならんでいる!$"

Text_ImpressiveMachine::
	.string "なんだか\nすごそうな きかいだ!$"

Text_VideoGame::
	.string "さいしんの ゲームだ!\nなんだか おもしろそう!$"

Text_Burglary::
	.string "どろぼうに あらされた あとが\nのこっている……$"

Text_PlayerFacingTVScreen::
	.string "テレビに ポケモンが\nうつっている!\lなんだか たのしそう!$"

